# Service-account keys — never commit these
*-service-account.json
bossbrand-*.json
gcs-*.json

# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenvs
venv/
vrmenv/
.venv/

# Migrations artifacts are kept, but not the local SQLite scratch DBs
*.sqlite3
*.db

# User-uploaded images (local storage backend only — production uses a bucket)
/uploads/*
!/uploads/*/
!/uploads/*/.gitkeep

# macOS / editors
.DS_Store
.idea/
.vscode/
