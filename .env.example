# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me

DB_HOST=localhost
DB_PORT=3306
DB_NAME=boss_brand
DB_USER=root
DB_PASSWORD=

# Bootstrap admin used by `flask seed`
ADMIN_EMAIL=admin@bossbrand.ai
ADMIN_PASSWORD=change-me
ADMIN_NAME=Boss Brand Admin

# File storage: "local" (default) writes uploads to ./uploads on disk.
# Set to "s3" in production to write to a bucket instead — fill in the S3_*
# values below (S3_ENDPOINT_URL is only needed for a non-AWS S3-compatible
# service, e.g. DigitalOcean Spaces or MinIO; S3_PUBLIC_BASE_URL only if a
# CDN sits in front of the bucket).
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
